<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Prevent infinite redirect loops
RewriteCond %{ENV:REDIRECT_STATUS} 200
RewriteRule ^ - [L]

# 1. Redirect /index.html and /index to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]

# 2. Redirect /home and /home.html to /about
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+home(\.html)?[\s?] [NC]
RewriteRule ^home(\.html)?$ /about [R=301,L]

# 3. Permanent 301 redirect for all external *.html requests to clean URLs
# Uses %{THE_REQUEST} so internal rewrites back to .html don't trigger a redirect loop
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# 4. Internally rewrite clean extensionless URL to .html if the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
</IfModule>
